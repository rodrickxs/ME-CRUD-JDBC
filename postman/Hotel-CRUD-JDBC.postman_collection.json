{
  "info": {
    "name": "Hotel - CRUD JDBC",
    "description": "Execute as requisicoes na ordem (1 a 10). A 1 grava reservaId e clienteId automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - POST Criar reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana Silva\",\n  \"sexo\": \"Feminino\",\n  \"email\": \"{{email}}\",\n  \"dataChegada\": \"2027-01-20\",\n  \"numeroNoites\": 3,\n  \"numeroHospedes\": 2,\n  \"mensagem\": \"Quarto silencioso, por favor.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.collectionVariables.set('reservaId', r.id);",
              "pm.collectionVariables.set('clienteId', r.clienteId);",
              "pm.test('Retornou id da reserva', () => pm.expect(r.id).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - GET Listar reservas por e-mail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reservas?email={{email}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ],
          "query": [
            {
              "key": "email",
              "value": "{{email}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Lista tem ao menos 1 reserva', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - GET Buscar reserva por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reservas/{{reservaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas",
            "{{reservaId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - PUT Atualizar reserva",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservas/{{reservaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas",
            "{{reservaId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataChegada\": \"2027-01-22\",\n  \"numeroNoites\": 4,\n  \"numeroHospedes\": 2,\n  \"mensagem\": \"Chegada após as 20h.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Noites atualizadas para 4', () => pm.expect(pm.response.json().numeroNoites).to.eql(4));"
            ]
          }
        }
      ]
    },
    {
